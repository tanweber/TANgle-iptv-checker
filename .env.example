# Настройки TANgle / TANgle settings
# Скопируйте этот файл в .env и измените значения под себя.
# Copy this file to .env and adjust the values.

# Порт на хосте, на котором будет доступен веб-интерфейс
# Host port for the web interface
TANGLE_PORT=9239

# Публичный адрес сервиса (без слеша в конце). Подставляется в плейлист
# как адрес ТВ-программы (x-tvg-url), поэтому должен быть доступен плеерам.
# Public URL of the service (no trailing slash). Written into the playlist
# as the TV guide address (x-tvg-url), so it must be reachable by players.
PUBLIC_URL=http://localhost:9239

# Сколько дней вперёд включать в ТВ-программу
# How many days ahead to include in the TV guide
EPG_DAYS=7

# Логин и пароль администратора — применяются только при первом запуске
# (пустая база). Потом меняются в интерфейсе: Настройки → Вход в систему.
# Admin login and password — used only on first start (empty database).
# Change them later in the UI: Settings → Sign-in.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
